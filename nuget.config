<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local-packages" value="local-packages" />
    <add key="global-cache" value="C:\Users\admin\.nuget\packages" />
  </packageSources>
</configuration>